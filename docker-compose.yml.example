version: '3.3'

services:
  nginx_api:
    image: rash07/nginx-api
    container_name: nginx_api
    working_dir: /var/www/html
    ports:
      - "${APP_PORT}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/default.conf:/etc/nginx/sites-available/default
    networks:
      - apinet

  php_api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: php_api
    working_dir: /var/www/html
    volumes:
      - ./:/var/www/html
    networks:
      - apinet

  scheduling_api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: scheduling_api
    working_dir: /var/www/html
    user: "www-data"
    command: sh -c "(while true; do php artisan queue:work database --tries=1 --timeout=3600 --max-time=3600 --no-interaction; sleep 5; done) & while true; do php artisan monitor:snapshot --no-interaction; sleep 10; done"
    pid: "host"
    volumes:
      - ./:/var/www/html
    networks:
      - apinet

  cufes-worker:
    build:
      context: ./extractcode
      dockerfile: Dockerfile
    image: cufes-worker:latest
    container_name: cufes-worker
    restart: unless-stopped
    shm_size: "1gb"
    mem_limit: "2g"
    environment:
      - NODE_OPTIONS=--openssl-legacy-provider
      - CHROME_HEADLESS=false
    ports:
      - "127.0.0.1:3001:3001"
    networks:
      - apinet
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:3001/api/jobs || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 25s

  mariadb:
    image: mariadb:11.5.2
    container_name: mariadb_api
    environment:
      - MYSQL_ROOT_PASSWORD="${DB_PASSWORD}"
    ports:
      - "${DB_PORT_EXTERNAL}:${DB_PORT}"
    volumes:
      - api_mysqldata:/var/lib/mysql
      # generar usuario y base de datos para utilizar en conexion del .env
      - ./docker/init.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - apinet

networks:
  apinet:
    external:
      name: apinet

volumes:
  api_mysqldata:
    driver: "local"

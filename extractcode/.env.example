# ============================================================
# Extractor DIAN — variables de entorno
# ============================================================
# Copiá este archivo a ".env" y cambiá solo lo que necesites:
#   cp .env.example .env
#
# Los valores de abajo son los DEFAULTS del sistema (ya configurados). Podés
# dejarlos como están y ajustar únicamente lo que te interese.
# Las variables definidas en el entorno (Docker/PM2/terminal) tienen
# prioridad sobre las de este archivo.
# ============================================================

# Clave de API. Si la definís, los endpoints /api/* exigen el header
# "X-Api-Key" con este mismo valor. Vacío = endpoints públicos.
# Recomendada en producción.
API_SECRET_KEY=

# Máximo de Chrome en paralelo (~200-400 MB de RAM c/u). El resto espera en cola.
MAX_CONCURRENT_SESSIONS=3

# Chrome headless en Linux. "false" abre Chrome con ventana.
#   - VPS nativo (sin Docker): dejar en "true" (headless).
#   - Docker: el script de instalación lo deja en "false" (Chrome corre bajo xvfb).
#   - Windows/Mac: no aplica.
# Podés cambiarlo en tu .env y reiniciar.
CHROME_HEADLESS=false

# Antigüedad máxima (horas) de las descargas antes de borrarlas automáticamente.
CLEANUP_MAX_AGE_HOURS=24

# Cada cuántas horas corre la limpieza automática de descargas.
CLEANUP_INTERVAL_HOURS=6

# Horas que viven en memoria los resultados de jobs asíncronos tras terminar.
JOB_TTL_HOURS=2

# Máximo de líneas de log que guarda cada job.
LOG_MAX_LINES=1000

# ── Pausas anti-bloqueo DIAN (método por token / URL) ──
# La DIAN bloquea ("Solicitud bloqueada por controles de seguridad") cuando
# detecta descargas demasiado rápidas. Se hace una pausa entre CADA documento y
# otra (mayor) al cambiar de página; a cada pausa se le suma un tiempo aleatorio
# de 0 a DELAY_JITTER_MS para que el ritmo no sea robótico. Subí estos valores si
# el bloqueo persiste (la extracción será más lenta).
# Espera entre cada descarga de factura (ms).
DELAY_DESCARGA_MS=8000
# Espera antes de pasar a la siguiente página (ms).
DELAY_PAGINA_MS=12000
# Tiempo aleatorio máximo extra que se suma a cada pausa (ms).
DELAY_JITTER_MS=4000
# Espera entre CADA línea/descarga (ms). La DIAN ahora redirige a una vista
# anti-bot al pulsar "descargar" (el ZIP baja igual, pero hay que retroceder al
# listado) y bloquea si el ritmo es muy rápido. 90000 = 90 segundos.
DELAY_LINEA_MS=90000
# Modo CUFE (no descarga nada): pausa corta entre páginas. 1500 = 1.5 segundos.
DELAY_CUFES_MS=1500

# ── Watchdog anti-cuelgue (libera slots de extracciones colgadas) ──
# Si una extracción NO emite ningún log por este tiempo (ms), se asume colgada
# (reCAPTCHA, página que no responde, cierre de Chrome trabado) y se aborta sola
# para liberar el slot — sin tener que reiniciar a mano con pm2.
# Bajalo para recuperar más rápido; subilo si tenés extracciones muy grandes.
SCRAPER_IDLE_TIMEOUT_MS=240000
# Tope duro de duración de una extracción (ms). Último recurso. 10800000 = 3 h.
# OJO: con DELAY_LINEA_MS=90000 (90 s/línea) cada documento tarda ~100-120s, así
# que este tope limita la corrida a unos (SCRAPER_MAX_RUNTIME_MS / 110s) documentos.
# Subilo si esperás listados grandes; el IDLE de arriba sigue matando los cuelgues.
SCRAPER_MAX_RUNTIME_MS=10800000

# ── API externo de XML por CUFEs (endpoint /api/xml-by-cufes) ──
# Método alternativo que NO descarga ZIPs de la DIAN: el extractor saca los CUFEs
# del listado (rápido, método token/URL) y le pide los XML a este API, que los
# consulta en la DIAN con el certificado (.p12) + contraseña. Con esos XML arma el
# mismo reporte. Requerido SOLO para usar /api/xml-by-cufes.
# URL base del API (sin la ruta). Ej: https://api.tudominio.com
XML_QUERY_API_URL=
# Clave que el API exige en su header X-Api-Key.
XML_QUERY_API_KEY=
# (opcional) Ruta del endpoint. Default: /api/ubl2.1/xml/by-cufes
# XML_QUERY_API_PATH=/api/ubl2.1/xml/by-cufes
# (opcional) CUFEs por lote (máx 500). Default: 500
# XML_QUERY_BATCH_SIZE=500
# (opcional) Timeout por request al API (ms). Default: 120000 (2 min)
# XML_QUERY_TIMEOUT_MS=120000
